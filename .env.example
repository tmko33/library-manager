# Application
APP_NAME="Library Manager API"
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/library
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/library_test

# Security
SECRET_KEY=insecure-development-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Business rules
LOAN_PERIOD_DAYS=14
MAX_ACTIVE_LOANS=5
FINE_PER_DAY=0.50
RESERVATION_HOLD_DAYS=3

# Demo data (set to true once on a fresh database, then remove)
SEED_DEMO_DATA=false
